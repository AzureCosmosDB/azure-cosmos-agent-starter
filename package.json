{
  "name": "create-cosmos-agent",
  "version": "0.1.0",
  "description": "Composable scaffolding for tenant-safe Azure Cosmos DB agents",
  "type": "module",
  "bin": {
    "create-cosmos-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "src/bases",
    "src/features",
    "src/scenarios"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.3",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.0.1"
  },
  "license": "MIT"
}
