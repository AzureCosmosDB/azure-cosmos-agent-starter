{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID=}" },
    "imageName": { "value": "${SERVICE_API_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}" },
    "entraTenantId": { "value": "${ENTRA_TENANT_ID}" },
    "entraAudience": { "value": "${ENTRA_AUDIENCE}" },
    "entraClientId": { "value": "${ENTRA_CLIENT_ID}" },
    "entraScope": { "value": "${ENTRA_SCOPE}" },
    "aiProvider": { "value": "${AI_PROVIDER=azure-openai}" },
    "azureOpenAIEndpoint": { "value": "${AZURE_OPENAI_ENDPOINT=}" },
    "azureOpenAIChatDeployment": { "value": "${AZURE_OPENAI_CHAT_DEPLOYMENT=}" },
    "openAIApiKey": { "value": "${OPENAI_API_KEY=}" },
    "openAIModel": { "value": "${OPENAI_MODEL=gpt-4.1-mini}" },
    "openAIBaseUrl": { "value": "${OPENAI_BASE_URL=https://api.openai.com/v1}" },
    "ollamaBaseUrl": { "value": "${OLLAMA_BASE_URL=http://localhost:11434}" },
    "ollamaModel": { "value": "${OLLAMA_MODEL=llama3.2}" }
  }
}
