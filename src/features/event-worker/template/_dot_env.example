NODE_ENV=development
MEMORY_BACKEND={{DEFAULT_STORAGE_BACKEND}}
AI_PROVIDER={{DEFAULT_AI_PROVIDER}}
EVENT_TRANSPORT=stdin

# Azure Service Bus (required when EVENT_TRANSPORT=service-bus)
SERVICE_BUS_NAMESPACE=
SERVICE_BUS_QUEUE=agent-events

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cosmos DB (required when MEMORY_BACKEND=cosmos)
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_DATABASE=cosmos-agent
COSMOS_EMULATOR=true
COSMOS_EMULATOR_KEY=
APPLICATIONINSIGHTS_CONNECTION_STRING=
