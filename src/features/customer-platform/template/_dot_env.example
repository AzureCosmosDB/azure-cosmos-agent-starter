NODE_ENV=development
PORT=3000
MEMORY_BACKEND=in-memory
AUTH_MODE=local
AI_PROVIDER=mock

# Microsoft Entra ID (required when AUTH_MODE=entra)
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_AUDIENCE=
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_SCOPE=
VITE_AUTH_MODE=local
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_API_SCOPE=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cosmos DB (required when MEMORY_BACKEND=cosmos)
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_DATABASE=cosmos-agent
COSMOS_EMULATOR=true
COSMOS_EMULATOR_KEY=
APPLICATIONINSIGHTS_CONNECTION_STRING=
