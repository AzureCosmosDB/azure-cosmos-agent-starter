{
  "name": "{{PROJECT_NAME}}",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:cost": "vitest run tests/cost",
    "test:integration": "vitest run tests/integration",
    "seed": "tsx scripts/seed.ts",
    "cleanup": "tsx scripts/cleanup.ts"
  },
  "dependencies": {
    "@azure/cosmos": "^4.4.1",
    "@azure/identity": "^4.12.0",
    "@opentelemetry/api": "^1.9.0",
    "express": "^5.1.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
